[Unit]
Description=Campus Door Control API Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/campus_door_master
ExecStart=/usr/bin/python3 /opt/campus_door_master/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 环境变量（必须配置 API 鉴权密钥；建议使用 root-only 文件保存）
EnvironmentFile=-/etc/campus_door_master/campus-door-master.env
# Environment=PYTHONPATH=/opt/campus_door_master
# Environment=LOG_LEVEL=INFO

# 资源限制（可选）
# MemoryMax=512M
# CPUQuota=50%

[Install]
WantedBy=multi-user.target
