[Unit]
Description=Campus Door Master API Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campusdoor
Group=campusdoor
WorkingDirectory=/opt/campus-door-master
ExecStart=/opt/campus-door-master/.venv/bin/python /opt/campus-door-master/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 环境变量文件由 deploy_centos10.sh 放在项目目录中
EnvironmentFile=-/opt/campus-door-master/campus-door-master.env
# Environment=PYTHONPATH=/opt/campus-door-master
# Environment=LOG_LEVEL=INFO

# 资源限制（可选）
# MemoryMax=512M
# CPUQuota=50%

[Install]
WantedBy=multi-user.target
