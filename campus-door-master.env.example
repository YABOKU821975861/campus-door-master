# 部署脚本会将此文件复制为 /opt/campus-door-master/campus-door-master.env。
# 按需填写后再启动服务。
# 如果不配置 ADO_API_KEY，项目首次启动会自动生成并保存到 storage/api_key。
# API Key 建议使用至少 32 字节的随机字符串
# ADO_API_KEY=请替换为高强度随机密钥
# 轮换时可临时改用多个 Key（逗号分隔），新旧 Key 会同时有效：
# ADO_API_KEYS=旧密钥,新密钥
ADO_DEBUG=false
ADO_USERNAME=
ADO_PASSWORD=
ADO_BASE_URL=https://your-ado-server:port
ADO_VERIFY_SSL=false
ADO_PREWARM_TOKEN=false
ADO_LOG_MAX_BYTES=10485760
ADO_LOG_BACKUP_COUNT=5

# IDST device system (separate from the campus door system above)
IDST_BASE_URL=https://172.20.196.253
IDST_USERNAME=
IDST_PASSWORD=
IDST_LOGIN_TIMEOUT_SECONDS=10
IDST_WS_TIMEOUT_SECONDS=10
IDST_TOKEN_CACHE_TTL=600
IDST_VERIFY_SSL=false
