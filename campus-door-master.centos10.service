[Unit]
Description=Campus Door Master API Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campusdoor
Group=campusdoor
WorkingDirectory=/opt/campus-door-master
ExecStart=/opt/campus-door-master/.venv/bin/python /opt/campus-door-master/main.py
EnvironmentFile=-/opt/campus-door-master/campus-door-master.env
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
